# Sepolia RPC URL (you can use a free one from Alchemy, Infura, or public nodes)
# Get one from: https://www.alchemy.com/ or https://infura.io/
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Your wallet private key (DO NOT SHARE THIS!)
# Export from MetaMask: Account Details > Export Private Key
# IMPORTANT: Make sure this wallet has Sepolia ETH for deployment
PRIVATE_KEY=your_private_key_here

# Etherscan API Key (for contract verification)
# Get one from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here
